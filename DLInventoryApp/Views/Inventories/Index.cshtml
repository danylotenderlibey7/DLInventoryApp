@using DLInventoryApp.ViewModels.Common.Pagination
@using DLInventoryApp.ViewModels.Inventories.Pages
@model PagedVm<MyInventoryRowVm>
@using System.Linq

<div class="page-header">

    <div>
        <h1 class="page-title">All Inventories</h1>
    </div>

    <nav class="pager-top" aria-label="Inventories pagination">

        <div class="pager-left">

            <div class="inv-tabs">

                <a class="inv-tab @(ViewBag.View == "latest" ? "active" : "")"
                   asp-action="Index"
                   asp-route-view="latest">
                    Latest
                </a>

                <a class="inv-tab @(ViewBag.View == "popular" ? "active" : "")"
                   asp-action="Index"
                   asp-route-view="popular">
                    Popular
                </a>

                <a class="inv-tab @(ViewBag.View == "all" ? "active" : "")"
                   asp-action="Index"
                   asp-route-view="all">
                    All
                </a>
            </div>

        </div>

        <div class="pager-right">

            @if (Model.TotalPages > 1)
            {
                <a class="pager-btn @(Model.HasPrevPage ? "" : "disabled")"
                   asp-action="Index"
                   asp-route-view="@ViewBag.View"
                   asp-route-tag="@Context.Request.Query["tag"]"
                   asp-route-page="@(Model.Page - 1)"
                   asp-route-pageSize="@Model.PageSize">
                    ‹
                </a>

                <span class="pager-info">@Model.Page / @Model.TotalPages</span>

                <a class="pager-btn @(Model.HasNextPage ? "" : "disabled")"
                   asp-action="Index"
                   asp-route-view="@ViewBag.View"
                   asp-route-tag="@Context.Request.Query["tag"]"
                   asp-route-page="@(Model.Page + 1)"
                   asp-route-pageSize="@Model.PageSize">
                    ›
                </a>
            }

        </div>

    </nav>

</div>


@if (!Model.Items.Any())
{
    <div class="empty-state">

        <div class="empty-title">
            No inventories yet
        </div>

        <div class="empty-sub">
            Create your first inventory to get started.
        </div>

        <div class="mt-3">
            <a class="app-btn app-btn-primary" asp-action="Create">
                + New Inventory
            </a>
        </div>

    </div>
}
else
{

    <div class="inv-table-wrap inv-table-card">
        <div class="inv-table-scroll inv-main-table-scroll">
            <table class="inv-table">

                <thead>
                    <tr>
                        <th class="inv-col-title">Inventory</th>
                        <th class="inv-col-items">Items</th>
                        <th class="inv-col-owner">Owner</th>
                        <th class="inv-col-updated">Last update</th>
                        <th class="inv-col-cat">Category</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var inv in Model.Items)
                    {
                        <tr class="inv-row"
                            data-href="@Url.Action("Details", "Inventories", new { id = inv.Id })">

                            <td>
                                <div class="inv-title">
                                    @inv.Title
                                </div>
                            </td>

                            <td class="inv-items">
                                [@inv.ItemsCount]
                            </td>

                            <td class="inv-owner">
                                @if (!string.IsNullOrWhiteSpace(inv.OwnerId))
                                {
                                    <a class="inv-owner-link"
                                       href="/profile/@inv.OwnerId"
                                       onclick="event.stopPropagation();">
                                        @(inv.OwnerUserName ?? "User")
                                    </a>
                                }
                                else
                                {
                                    @(inv.OwnerUserName ?? "User")
                                }
                            </td>

                            <td class="inv-updated"
                                data-date="@((inv.UpdatedAt ?? inv.CreatedAt).ToString("o"))">
                            </td>

                            <td class="inv-cat">
                                @(inv.CategoryName ?? "-")
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
}


@if (ViewBag.TagCloud != null)
{

    <div class="tag-cloud-block">

        <div class="tag-cloud-title">
            Tags
        </div>

        <div class="tag-cloud">

            @foreach (var tag in ViewBag.TagCloud)
            {
                <a class="inv-tag @(Context.Request.Query["tag"] == tag ? "active" : "")"
                   asp-controller="Inventories"
                   asp-action="Index"
                   asp-route-tag="@tag">
                    #@tag
                </a>
            }

        </div>

    </div>

}


@section Scripts {

    <script>

        document.addEventListener("click", function (e) {

        const row = e.target.closest(".inv-row");
        if (!row) return;

        if (e.target.closest("a")) return;
        if (e.target.closest("input")) return;

        const href = row.getAttribute("data-href");

        if (href) window.location.href = href;

        });


        document.querySelectorAll(".inv-updated").forEach(el=>{

        const date=new Date(el.dataset.date);
        const now=new Date();

        const diff=(now-date)/1000;

        let text="";

        if(diff<60){
        text="just now";
        }
        else if(diff<3600){
        const m=Math.floor(diff/60);
        text=m+" min ago";
        }
        else if(diff<86400){
        const h=Math.floor(diff/3600);
        text=h+" hour"+(h>1?"s":"")+" ago";
        }
        else if(diff<604800){
        const d=Math.floor(diff/86400);
        text=d+" day"+(d>1?"s":"")+" ago";
        }
        else{
        const w=Math.floor(diff/604800);
        text=w+" week"+(w>1?"s":"")+" ago";
        }

        el.textContent=text;

        });

    </script>

}
@page
@model ChangePasswordModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="workspace-inner profile-page">
    <div class="manage-layout">

        <aside class="manage-sidebar">
            <partial name="_ManageNav" />
        </aside>

        <div class="manage-content">

            <div class="page-header">
                <div>
                    <h1 class="page-title">Change password</h1>
                    <p class="page-subtitle">Update your account password.</p>
                </div>
            </div>

            <partial name="_StatusMessage" for="StatusMessage" />

            <div class="manage-form-card">
                <form id="change-password-form" method="post" class="manage-form">
                    <div asp-validation-summary="ModelOnly" class="auth-validation"></div>

                    <div class="manage-form-grid">

                        <div class="auth-field">
                            <label asp-for="Input.OldPassword" class="auth-label"></label>
                            <input asp-for="Input.OldPassword"
                                   class="auth-input"
                                   autocomplete="current-password"
                                   aria-required="true"
                                   placeholder="Current password" />
                            <span asp-validation-for="Input.OldPassword" class="auth-field-error"></span>
                        </div>

                        <div class="auth-field">
                            <label asp-for="Input.NewPassword" class="auth-label"></label>
                            <input asp-for="Input.NewPassword"
                                   class="auth-input"
                                   autocomplete="new-password"
                                   aria-required="true"
                                   placeholder="New password" />
                            <span asp-validation-for="Input.NewPassword" class="auth-field-error"></span>
                        </div>

                        <div class="auth-field">
                            <label asp-for="Input.ConfirmPassword" class="auth-label"></label>
                            <input asp-for="Input.ConfirmPassword"
                                   class="auth-input"
                                   autocomplete="new-password"
                                   aria-required="true"
                                   placeholder="Repeat new password" />
                            <span asp-validation-for="Input.ConfirmPassword" class="auth-field-error"></span>
                        </div>

                        <div class="manage-actions-row">
                            <button type="submit" class="app-btn app-btn-primary auth-submit">
                                <i class="bi bi-shield-lock"></i>
                                <span>Update password</span>
                            </button>
                        </div>

                    </div>
                </form>
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
} 
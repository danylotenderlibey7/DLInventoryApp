@page
@model ResetPasswordConfirmationModel

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Password reset complete";
}

<div class="workspace-inner auth-wide-page">
    <section class="auth-wide-card">
        <div class="auth-wide-grid">

            <div class="auth-side">

                <h1 class="auth-side-title">Password updated</h1>

                <p class="auth-side-text">
                    Your password has been successfully reset.
                    You can now log in using your new password.
                </p>

                <div class="auth-side-actions">

                    <a class="auth-action-card" asp-page="./Login">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <div>
                            <div class="auth-action-title">Go to login</div>
                            <div class="auth-action-text">Sign in to your account.</div>
                        </div>
                    </a>

                    <a class="auth-action-card" asp-page="./Register">
                        <i class="bi bi-person-plus"></i>
                        <div>
                            <div class="auth-action-title">Create account</div>
                            <div class="auth-action-text">Register a new user account.</div>
                        </div>
                    </a>

                    <a class="auth-action-card" asp-page="./ForgotPassword">
                        <i class="bi bi-key"></i>
                        <div>
                            <div class="auth-action-title">Forgot password again</div>
                            <div class="auth-action-text">Request another reset link.</div>
                        </div>
                    </a>

                </div>

            </div>

            <div class="auth-form-side">

                <div class="auth-form-head">
                    <h2 class="auth-form-title">All set</h2>
                    <p class="auth-form-subtitle">
                        Your account password has been changed successfully.
                    </p>
                </div>

                <div class="auth-validation">
                    You can now safely sign in with your new password.
                </div>

                <div style="margin-top:20px;">
                    <a asp-page="./Login" class="app-btn app-btn-accent auth-submit">
                        Log in
                    </a>
                </div>

            </div>

        </div>
    </section>
</div>
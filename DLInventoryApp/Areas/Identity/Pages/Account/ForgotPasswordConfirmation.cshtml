@page
@model DLInventoryApp.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Password reset email sent";
}

<div class="workspace-inner auth-wide-page">
    <section class="auth-wide-card">
        <div class="auth-wide-grid">

            <div class="auth-side">
                <h1 class="auth-side-title">Check your email</h1>

                <p class="auth-side-text">
                    If an account with that email exists and the address is confirmed,
                    a password reset link has been sent to your inbox.
                </p>

                <div class="auth-side-actions">
                    <a class="auth-action-card" asp-page="./Login">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <div>
                            <div class="auth-action-title">Back to login</div>
                            <div class="auth-action-text">Return to the login page.</div>
                        </div>
                    </a>

                    <a class="auth-action-card" asp-page="./Register">
                        <i class="bi bi-person-plus"></i>
                        <div>
                            <div class="auth-action-title">Create account</div>
                            <div class="auth-action-text">Register a new user account.</div>
                        </div>
                    </a>

                    <a class="auth-action-card" asp-page="./ResendEmailConfirmation">
                        <i class="bi bi-envelope"></i>
                        <div>
                            <div class="auth-action-title">Resend confirmation</div>
                            <div class="auth-action-text">Send confirmation email again.</div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="auth-form-side">
                <div class="auth-form-head">
                    <h2 class="auth-form-title">Email sent</h2>
                    <p class="auth-form-subtitle">
                        Please check your email and follow the instructions to reset your password.
                    </p>
                </div>

                <div class="auth-validation">
                    The reset link may take a minute to arrive. Also check your spam folder.
                </div>
            </div>

        </div>
    </section>
</div>
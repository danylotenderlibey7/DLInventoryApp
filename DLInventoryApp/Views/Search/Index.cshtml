@using DLInventoryApp.ViewModels.Items.Search
@model SearchResultVm

@{
    ViewData["Title"] = "Search";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Search</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Query))
        {
            <div class="page-subtitle">
                Results for: <span class="page-meta">@Model.Query</span>
            </div>
        }
    </div>
</div>

@if (string.IsNullOrWhiteSpace(Model.Query))
{
    <div class="empty-state">
        <div class="empty-title">Enter a search query</div>
        <div class="empty-sub">Use the search box in the sidebar to find inventories and items.</div>
    </div>
    return;
}

<div class="my-section">
    <div class="my-section-head">
        <div class="my-section-title">Inventories</div>
    </div>

    @if (Model.Inventories == null || Model.Inventories.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-title">No inventories found</div>
            <div class="empty-sub">Try another query.</div>
        </div>
    }
    else
    {
        <div class="inv-table-wrap">
            <table class="inv-table">
                <thead>
                    <tr>
                        <th class="inv-col-title">Inventory</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model.Inventories)
                    {
                        <tr class="inv-row"
                            data-href="@Url.Action("Details", "Inventories", new { id = inv.Id, tab = "items" })">
                            <td>
                                <div class="inv-title">@inv.Title</div>
                            </td>
                            <td class="col-muted">
                                @(string.IsNullOrWhiteSpace(inv.Snippet) ? "-" : inv.Snippet)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="my-section">
    <div class="my-section-head">
        <div class="my-section-title">Items</div>
    </div>

    @if (Model.Items == null || Model.Items.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-title">No items found</div>
            <div class="empty-sub">Try another query.</div>
        </div>
    }
    else
    {
        <div class="inv-table-wrap">
            <table class="inv-table">
                <thead>
                    <tr>
                        <th>Custom ID</th>
                        <th>Inventory</th>
                        <th>Snippet</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr class="inv-row"
                            data-href="@Url.Action("Details", "Inventories", new { id = item.InventoryId, tab = "items" })">
                            <td>
                                <div class="inv-title">@item.CustomId</div>
                            </td>
                            <td class="col-muted">
                                @(string.IsNullOrWhiteSpace(item.InventoryTitle) ? "-" : item.InventoryTitle)
                            </td>
                            <td class="col-muted">
                                @(string.IsNullOrWhiteSpace(item.Snippet) ? "-" : item.Snippet)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            document.addEventListener("click", function (e) {
                const row = e.target.closest(".inv-row");
                if (!row) return;

                if (e.target.closest("a")) return;
                if (e.target.closest("button")) return;
                if (e.target.closest("input")) return;

                const href = row.dataset.href;
                if (href) window.location.href = href;
            });
        })();
    </script>
}
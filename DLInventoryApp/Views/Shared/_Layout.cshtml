<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DLInventoryApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/access.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/chat.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/customid.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/fields.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/inventories.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/items.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/settings.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>

<body data-theme="light">

    <div class="app-shell" id="appShell">

        <aside class="app-sidebar">

            <div class="sidebar-top">

                <div class="sidebar-header">
                    <a asp-controller="Inventories"
                       asp-action="Index"
                       class="brand">
                        <span>DLInventory</span>
                    </a>

                    <button id="sidebarCollapseBtn"
                            class="sidebar-collapse-btn"
                            type="button"
                            aria-label="Collapse sidebar">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                </div>

                <form asp-controller="Search"
                      asp-action="Index"
                      method="get"
                      class="sidebar-search"
                      autocomplete="off">

                    <div class="sidebar-search-wrap">
                        <i class="bi bi-search sidebar-search-icon"></i>

                        <input type="text"
                               id="searchBox"
                               name="query"
                               placeholder="Search..."
                               class="form-control form-control-sm sidebar-search-input"
                               value="@Context.Request.Query["query"]" />

                        <div id="searchSuggest"
                             class="position-absolute start-0 mt-1 w-100 bg-white border rounded shadow-sm"
                             style="display:none; z-index:2000;"></div>
                    </div>
                </form>

            </div>

            <nav class="sidebar-nav">

                @{
                    var controller = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLower();
                    var action = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLower();

                    string Active(string c, string a = "")
                    {
                        var ok = controller == c.ToLower()
                        && (string.IsNullOrEmpty(a) || action == a.ToLower());

                        return ok ? "active" : "";
                    }
                }

                <a class="nav-item @Active("Inventories","Index")"
                   asp-controller="Inventories"
                   asp-action="Index">
                    <i class="bi bi-archive"></i>
                    <span>All Inventories</span>
                </a>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a class="nav-item @Active("Inventories","My")"
                       asp-controller="Inventories"
                       asp-action="My">
                        <i class="bi bi-person"></i>
                        <span>My Inventories</span>
                    </a>

                    <a class="nav-item nav-item-accent @Active("Inventories","Create")"
                       asp-controller="Inventories"
                       asp-action="Create">
                        <i class="bi bi-plus-lg"></i>
                        <span>New Inventory</span>
                    </a>
                }

                <a class="nav-item @Active("Tags","Index")"
                   asp-controller="Tags"
                   asp-action="Index">
                    <i class="bi bi-tags"></i>
                    <span>All tags</span>
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <a class="nav-item @Active("Admin","Users")"
                       asp-controller="Admin"
                       asp-action="Users">
                        <i class="bi bi-shield-lock"></i>
                        <span>Users</span>
                    </a>
                }

            </nav>

            <div class="sidebar-bottom">

                <div class="sidebar-switches">

                    <div class="sidebar-switch" id="themeSwitch" role="group" aria-label="Theme switch">
                        <button type="button"
                                class="sidebar-switch-btn"
                                id="themeLightBtn"
                                data-theme-value="light"
                                aria-label="Light theme"
                                title="Light theme">
                            <i class="bi bi-sun"></i>
                        </button>

                        <button type="button"
                                class="sidebar-switch-btn"
                                id="themeDarkBtn"
                                data-theme-value="dark"
                                aria-label="Dark theme"
                                title="Dark theme">
                            <i class="bi bi-moon"></i>
                        </button>
                    </div>

                    <div class="sidebar-switch" id="langSwitch" role="group" aria-label="Language switch">
                        <button type="button"
                                class="sidebar-switch-btn is-active"
                                id="langEnBtn"
                                data-lang-value="en"
                                aria-label="English"
                                title="English">
                            EN
                        </button>

                        <button type="button"
                                class="sidebar-switch-btn"
                                id="langUkBtn"
                                data-lang-value="uk"
                                aria-label="Ukrainian"
                                title="Ukrainian">
                            UA
                        </button>
                    </div>

                </div>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="sidebar-account-block">
                        <a href="/profile" class="nav-item">
                            <i class="bi bi-person-circle"></i>
                            <span>Personal page</span>
                        </a>

                        <form asp-area="Identity"
                              asp-page="/Account/Logout"
                              method="post"
                              class="sidebar-logout-form">
                            @Html.AntiForgeryToken()

                            <button type="submit" class="nav-item sidebar-logout-navbtn">
                                <i class="bi bi-door-open"></i>
                                <span>Logout</span>
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="sidebar-account-block">
                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           class="sidebar-account-link">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Login</span>
                        </a>
                    </div>
                }

            </div>
        </aside>

        <main class="app-workspace">
            <div class="workspace-inner">
                @RenderBody()
            </div>
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        (function () {
            const body = document.body;
            const searchInput = document.getElementById("searchBox");
            const suggestBox = document.getElementById("searchSuggest");
            const collapseBtn = document.getElementById("sidebarCollapseBtn");
            const shell = document.getElementById("appShell");

            if (collapseBtn) {
                const saved = localStorage.getItem("sidebarCollapsed");
                if (saved === "true") shell.classList.add("sidebar-collapsed");

                collapseBtn.onclick = () => {
                    shell.classList.toggle("sidebar-collapsed");
                    localStorage.setItem(
                        "sidebarCollapsed",
                        shell.classList.contains("sidebar-collapsed")
                    );
                };
            }

            if (searchInput && suggestBox) {
                let timer = null;
                let controller = null;
                let last = "";

                function hide() {
                    suggestBox.style.display = "none";
                    suggestBox.innerHTML = "";
                }

                async function load(q) {
                    if (controller) controller.abort();
                    controller = new AbortController();

                    const r = await fetch(`/Search/Suggest?query=${encodeURIComponent(q)}`, {
                        headers: { "X-Requested-With": "XMLHttpRequest" },
                        signal: controller.signal
                    });

                    if (!r.ok) {
                        hide();
                        return;
                    }

                    const html = (await r.text()).trim();

                    if (!html) {
                        hide();
                        return;
                    }

                    suggestBox.innerHTML = html;
                    suggestBox.style.display = "block";
                }

                searchInput.oninput = () => {
                    const q = searchInput.value.trim();

                    if (q.length < 2) {
                        last = "";
                        hide();
                        return;
                    }

                    if (q === last) return;
                    last = q;

                    clearTimeout(timer);
                    timer = setTimeout(() => load(q).catch(() => { }), 300);
                };

                document.addEventListener("click", e => {
                    if (e.target === searchInput || suggestBox.contains(e.target)) return;
                    hide();
                });

                searchInput.onkeydown = e => {
                    if (e.key === "Escape") hide();
                };
            }

            const lightBtn = document.getElementById("themeLightBtn");
            const darkBtn = document.getElementById("themeDarkBtn");

            function syncThemeButtons(theme) {
                lightBtn?.classList.toggle("is-active", theme === "light");
                darkBtn?.classList.toggle("is-active", theme === "dark");
            }

            function applyTheme(theme) {
                body.setAttribute("data-theme", theme);
                localStorage.setItem("theme", theme);
                syncThemeButtons(theme);
            }

            lightBtn?.addEventListener("click", () => applyTheme("light"));
            darkBtn?.addEventListener("click", () => applyTheme("dark"));

            const savedTheme =
                localStorage.getItem("theme") ||
                body.getAttribute("data-theme") ||
                "light";

            applyTheme(savedTheme);

            const langEnBtn = document.getElementById("langEnBtn");
            const langUkBtn = document.getElementById("langUkBtn");

            function syncLangButtons(lang) {
                langEnBtn?.classList.toggle("is-active", lang === "en");
                langUkBtn?.classList.toggle("is-active", lang === "uk");
            }

            function applyLang(lang) {
                localStorage.setItem("ui-lang-preview", lang);
                syncLangButtons(lang);
            }

            langEnBtn?.addEventListener("click", () => applyLang("en"));
            langUkBtn?.addEventListener("click", () => applyLang("uk"));

            const savedLang = localStorage.getItem("ui-lang-preview") || "en";
            syncLangButtons(savedLang);
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@page
@model ConfirmEmailModel

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Confirm email";
}
@inject Microsoft.Extensions.Localization.IStringLocalizer<DLInventoryApp.Localization.SharedResource> LocalizerS
@inject Microsoft.Extensions.Localization.IStringLocalizer<DLInventoryApp.Localization.UserResource> LocalizerU
@inject Microsoft.Extensions.Localization.IStringLocalizer<DLInventoryApp.Localization.AuthResource> LocalizerA

<div class="workspace-inner auth-wide-page">
    <section class="auth-wide-card">
        <div class="auth-wide-grid">

            <div class="auth-side">

                <h1 class="auth-side-title">@LocalizerA["EmailConfirmation"]</h1>

                <p class="auth-side-text">
                    @LocalizerA["YouEmailVerificationProcessed"]
                </p>

                <div class="auth-side-actions">

                    <a class="auth-action-card" asp-page="./Login">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <div>
                            <div class="auth-action-title">@LocalizerA["LogIn"]</div>
                            <div class="auth-action-text">@LocalizerA["SignInYourAccount"]</div>
                        </div>
                    </a>

                    <a class="auth-action-card" asp-page="./Register">
                        <i class="bi bi-person-plus"></i>
                        <div>
                            <div class="auth-action-title">@LocalizerA["CreateAccount"]</div>
                            <div class="auth-action-text">@LocalizerA["RegisterNewAccount"]</div>
                        </div>
                    </a>

                    <a class="auth-action-card" asp-page="./ResendEmailConfirmation">
                        <i class="bi bi-envelope"></i>
                        <div>
                            <div class="auth-action-title">@LocalizerA["ResendConfirmation"]</div>
                            <div class="auth-action-text">@LocalizerA["SendConfirmationAgain"]</div>
                        </div>
                    </a>

                </div>

            </div>

            <div class="auth-form-side">

                <div class="auth-form-head">
                    <h2 class="auth-form-title">@LocalizerA["ConfirmationResult"]</h2>
                    <p class="auth-form-subtitle">
                        @LocalizerA["YourEmailConfirmationStatus"]
                    </p>
                </div>

                <div class="auth-validation">
                    @Model.StatusMessage
                </div>

                <div style="margin-top:20px;">
                    <a asp-page="./Login" class="app-btn app-btn-accent auth-submit">
                        @LocalizerA["LogIn"]
                    </a>
                </div>

            </div>

        </div>
    </section>
</div>
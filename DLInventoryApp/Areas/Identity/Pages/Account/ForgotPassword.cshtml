@page
@model ForgotPasswordModel

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Forgot password";
}

<div class="workspace-inner auth-wide-page">
    <section class="auth-wide-card">
        <div class="auth-wide-grid">

            <div class="auth-side">
                <h1 class="auth-side-title">Forgot password</h1>

                <p class="auth-side-text">
                    Enter your confirmed email address and we will send you a password reset link.
                </p>

                <div class="auth-side-actions">
                    <a class="auth-action-card"
                       asp-page="./Login">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <div>
                            <div class="auth-action-title">Back to login</div>
                            <div class="auth-action-text">Return to the login page.</div>
                        </div>
                    </a>

                    <a class="auth-action-card"
                       asp-page="./Register">
                        <i class="bi bi-person-plus"></i>
                        <div>
                            <div class="auth-action-title">Create account</div>
                            <div class="auth-action-text">Register a new account.</div>
                        </div>
                    </a>

                    <a class="auth-action-card"
                       asp-page="./ResendEmailConfirmation">
                        <i class="bi bi-envelope"></i>
                        <div>
                            <div class="auth-action-title">Resend confirmation</div>
                            <div class="auth-action-text">Send confirmation email again.</div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="auth-form-side">
                <div class="auth-form-head">
                    <h2 class="auth-form-title">Reset password</h2>
                    <p class="auth-form-subtitle">Enter your email to receive a reset link</p>
                </div>

                <form method="post" class="auth-form-block">
                    <div asp-validation-summary="ModelOnly" class="auth-validation"></div>

                    <div class="auth-field">
                        <label asp-for="Input.Email" class="auth-label"></label>
                        <input asp-for="Input.Email"
                               class="auth-input"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="auth-field-error"></span>
                    </div>

                    <button type="submit" class="inv-btn inv-btn-accent auth-submit">
                        Send reset link
                    </button>
                </form>
            </div>

        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
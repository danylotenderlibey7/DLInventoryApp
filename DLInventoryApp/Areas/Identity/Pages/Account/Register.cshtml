@page
@model RegisterModel

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Register";
}

<div class="workspace-inner auth-wide-page">
    <section class="auth-wide-card">
        <div class="auth-wide-grid">

            <div class="auth-side">
                <h1 class="auth-side-title">Create account</h1>

                <p class="auth-side-text">
                    Register to create inventories and manage your personal page.
                </p>

                <div class="auth-side-actions">
                    <a class="auth-action-card"
                       asp-page="./Login"
                       asp-route-returnUrl="@Model.ReturnUrl">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <div>
                            <div class="auth-action-title">Already have account</div>
                            <div class="auth-action-text">Go to login page.</div>
                        </div>
                    </a>

                    <a class="auth-action-card"
                       asp-page="./ForgotPassword">
                        <i class="bi bi-key"></i>
                        <div>
                            <div class="auth-action-title">Forgot password</div>
                            <div class="auth-action-text">Reset your access.</div>
                        </div>
                    </a>

                    <a class="auth-action-card"
                       asp-page="./ResendEmailConfirmation">
                        <i class="bi bi-envelope"></i>
                        <div>
                            <div class="auth-action-title">Resend confirmation</div>
                            <div class="auth-action-text">Send confirmation again.</div>
                        </div>
                    </a>
                </div>

                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <div class="auth-divider">
                        <span>Continue with</span>
                    </div>

                    <form asp-page="./ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post"
                          class="auth-provider-list">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            var icon = "bi-box-arrow-in-right";

                            if (provider.Name.ToLower().Contains("google")) icon = "bi-google";
                            if (provider.Name.ToLower().Contains("facebook")) icon = "bi-facebook";

                            <button type="submit"
                                    name="provider"
                                    value="@provider.Name"
                                    class="auth-provider-btn">
                                <i class="bi @icon"></i>
                                <span>@provider.DisplayName</span>
                            </button>
                        }
                    </form>
                }
            </div>

            <div class="auth-form-side">
                <div class="auth-form-head">
                    <h2 class="auth-form-title">Register</h2>
                    <p class="auth-form-subtitle">Create a new account</p>
                </div>

                <form method="post"
                      asp-route-returnUrl="@Model.ReturnUrl"
                      class="auth-form-block">
                    <div asp-validation-summary="ModelOnly" class="auth-validation"></div>

                    <div class="auth-field">
                        <label asp-for="Input.UserName" class="auth-label"></label>
                        <input asp-for="Input.UserName"
                               class="auth-input"
                               placeholder="User name" />
                        <span asp-validation-for="Input.UserName" class="auth-field-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Input.Email" class="auth-label"></label>
                        <input asp-for="Input.Email"
                               class="auth-input"
                               placeholder="name@email.com" />
                        <span asp-validation-for="Input.Email" class="auth-field-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Input.Password" class="auth-label"></label>
                        <input asp-for="Input.Password"
                               class="auth-input"
                               placeholder="Password" />
                        <span asp-validation-for="Input.Password" class="auth-field-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Input.ConfirmPassword" class="auth-label"></label>
                        <input asp-for="Input.ConfirmPassword"
                               class="auth-input"
                               placeholder="Repeat password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="auth-field-error"></span>
                    </div>

                    <button type="submit" class="app-btn app-btn-primary auth-submit">
                        Create account
                    </button>
                </form>
            </div>

        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
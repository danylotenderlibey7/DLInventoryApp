@page
@model ForgotPasswordModel

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Forgot password";
}
@inject Microsoft.Extensions.Localization.IStringLocalizer<DLInventoryApp.Localization.SharedResource> LocalizerS
@inject Microsoft.Extensions.Localization.IStringLocalizer<DLInventoryApp.Localization.UserResource> LocalizerU
@inject Microsoft.Extensions.Localization.IStringLocalizer<DLInventoryApp.Localization.AuthResource> LocalizerA

<div class="workspace-inner auth-wide-page">
    <section class="auth-wide-card">
        <div class="auth-wide-grid">

            <div class="auth-side">
                <h1 class="auth-side-title">@LocalizerA["ForgotPassword"]</h1>

                <p class="auth-side-text">
                    @LocalizerA["EnterConfirmedEmailETC"]
                </p>

                <div class="auth-side-actions">
                    <a class="auth-action-card"
                       asp-page="./Login">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <div>
                            <div class="auth-action-title">@LocalizerA["BackToLogin"]</div>
                            <div class="auth-action-text">@LocalizerA["ReturnLoginPage"]</div>
                        </div>
                    </a>

                    <a class="auth-action-card"
                       asp-page="./Register">
                        <i class="bi bi-person-plus"></i>
                        <div>
                            <div class="auth-action-title">@LocalizerA["CreateAccount"]</div>
                            <div class="auth-action-text">@LocalizerA["RegisterNewAccount"]</div>
                        </div>
                    </a>

                    <a class="auth-action-card"
                       asp-page="./ResendEmailConfirmation">
                        <i class="bi bi-envelope"></i>
                        <div>
                            <div class="auth-action-title">@LocalizerA["ResendConfirmation"]</div>
                            <div class="auth-action-text">@LocalizerA["SendConfirmationAgain"]</div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="auth-form-side">
                <div class="auth-form-head">
                    <h2 class="auth-form-title">@LocalizerA["ResetPassword"]</h2>
                    <p class="auth-form-subtitle">@LocalizerA["EnterEmailWillSendConfirmation"]</p>
                </div>

                <form method="post" class="auth-form-block">
                    <div asp-validation-summary="ModelOnly" class="auth-validation"></div>

                    <div class="auth-field">
                        <label asp-for="Input.Email" class="auth-label">Email</label>
                        <input asp-for="Input.Email"
                               class="auth-input"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="auth-field-error"></span>
                    </div>

                    <button type="submit" class="app-btn app-btn-primary auth-submit">
                        @LocalizerA["SendResetLink"]
                    </button>
                </form>
            </div>

        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@page
@model BlockedModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Account blocked";
}

<div class="workspace-inner auth-wide-page">
    <section class="auth-wide-card">
        <div class="auth-wide-grid">

            <div class="auth-side">

                <h1 class="auth-side-title">Account blocked</h1>

                <p class="auth-side-text">
                    Your account has been temporarily blocked by the administrators.
                    If you believe this is a mistake, please contact support.
                </p>

                <div class="auth-side-actions">

                    <a class="auth-action-card" href="mailto:support@yourapp.com">
                        <i class="bi bi-envelope"></i>
                        <div>
                            <div class="auth-action-title">Contact support</div>
                            <div class="auth-action-text">
                                Send us an email and we will review your account.
                            </div>
                        </div>
                    </a>

                    <a class="auth-action-card" asp-area="Identity" asp-page="/Account/Login">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <div>
                            <div class="auth-action-title">Back to login</div>
                            <div class="auth-action-text">
                                Try signing in with another account.
                            </div>
                        </div>
                    </a>

                    <a class="auth-action-card" asp-page="/Index">
                        <i class="bi bi-house"></i>
                        <div>
                            <div class="auth-action-title">Go to home</div>
                            <div class="auth-action-text">
                                Return to the main page of the application.
                            </div>
                        </div>
                    </a>

                </div>

            </div>

            <div class="auth-form-side">

                <div class="auth-form-head">
                    <h2 class="auth-form-title">Access restricted</h2>
                    <p class="auth-form-subtitle">
                        Your account is currently not allowed to access the system.
                    </p>
                </div>

                <div class="auth-validation">
                    Your account has been blocked.
                    If you think this is an error, please contact support.
                </div>

            </div>

        </div>
    </section>
</div>
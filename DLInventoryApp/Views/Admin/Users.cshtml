@using DLInventoryApp.ViewModels.Common.Pagination
@using DLInventoryApp.ViewModels.Admin
@model PagedVm<UserAdminVm>
@inject Microsoft.Extensions.Localization.IStringLocalizer<DLInventoryApp.Localization.SharedResource> LocalizerShared
@inject Microsoft.Extensions.Localization.IStringLocalizer<DLInventoryApp.Localization.AdminResource> LocalizerAd


@{
    ViewData["Title"] = "Users";
}

<div class="page-header">
    <div>
        <h1 class="page-title">@LocalizerAd["UserManagement"]</h1>
    </div>
</div>

<form method="post" id="adminUsersForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="page" value="@Model.Page" />
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    <div class="my-section">
        <div class="my-section-head">

            <nav class="pager-top my-section-pager" aria-label="Users pagination">
                <div class="pager-right">

                    <div class="inv-actions admin-users-actions">
                        <button type="submit"
                                formaction="@Url.Action("Block", "Admin")"
                                id="blockUsersBtn"
                                class="app-btn app-btn-primary app-btn-icon"
                                title="Block selected users">
                            <i class="bi bi-lock"></i>
                        </button>

                        <button type="submit"
                                formaction="@Url.Action("Unblock", "Admin")"
                                id="unblockUsersBtn"
                                class="app-btn app-btn-primary app-btn-icon"
                                title="Unblock selected users">
                            <i class="bi bi-unlock"></i>
                        </button>

                        <button type="submit"
                                formaction="@Url.Action("Delete", "Admin")"
                                id="deleteUsersBtn"
                                class="app-btn app-btn-primary app-btn-icon"
                                title="Delete selected users">
                            <i class="bi bi-trash"></i>
                        </button>

                        <button type="submit"
                                formaction="@Url.Action("AddAdmin", "Admin")"
                                id="addAdminBtn"
                                class="app-btn app-btn-primary app-btn-icon"
                                title="Add admin role">
                            <i class="bi bi-shield-plus"></i>
                        </button>

                        <button type="submit"
                                formaction="@Url.Action("RemoveAdmin", "Admin")"
                                id="removeAdminBtn"
                                class="app-btn app-btn-primary app-btn-icon"
                                title="Remove admin role">
                            <i class="bi bi-shield-minus"></i>
                        </button>
                    </div>

                    @if (Model.TotalPages > 1)
                    {
                        <a class="pager-btn @(Model.HasPrevPage ? "" : "disabled")"
                           asp-action="Users"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-pageSize="@Model.PageSize">
                            ‹
                        </a>

                        <span class="pager-info">@Model.Page / @Model.TotalPages</span>

                        <a class="pager-btn @(Model.HasNextPage ? "" : "disabled")"
                           asp-action="Users"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-pageSize="@Model.PageSize">
                            ›
                        </a>
                    }

                </div>
            </nav>
        </div>

        @if (Model == null || !Model.Items.Any())
        {
            <div class="empty-state">
                <div class="empty-title">@LocalizerAd["NoUsersFound"]</div>
                <div class="empty-sub">@LocalizerAd["UserAccountsWillAppearHere"]</div>
            </div>
        }
        else
        {
            <div class="inv-table-wrap admin-users-table-wrap">
                <div class="admin-users-table-scroll">
                    <table class="inv-table admin-users-table">
                        <thead>
                            <tr>
                                <th class="col-check">
                                    <input type="checkbox" id="selectAll" aria-label="Select all users" />
                                </th>
                                <th class="col-username">@LocalizerShared["User"]</th>
                                <th class="col-email">Email</th>
                                <th class="col-status ta-center">@LocalizerShared["Confirmed"]</th>
                                <th class="col-status ta-center">@LocalizerShared["Blocked"]</th>
                                <th class="col-status ta-center">@LocalizerShared["Role"]</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var user in Model.Items)
                            {
                                <tr class="admin-user-row">
                                    <td class="col-check">
                                        <input type="checkbox"
                                               name="userIds"
                                               value="@user.Id"
                                               class="user-checkbox" />
                                    </td>

                                    <td class="col-username">
                                        <div class="inv-title admin-user-name">
                                            <a class="admin-user-link" href="/profile/@user.Id">
                                                @user.UserName
                                            </a>
                                        </div>
                                    </td>

                                    <td class="col-email">
                                        <div class="inv-title admin-user-email">
                                            @user.Email
                                        </div>
                                    </td>

                                    <td class="col-status ta-center">
                                        <span class="admin-state-icon"
                                              title="@(user.EmailConfirmed ? "Email confirmed" : "Email not confirmed")">
                                            <i class="bi @(user.EmailConfirmed ? "bi-check-lg" : "bi-x-lg")"></i>
                                        </span>
                                    </td>

                                    <td class="col-status ta-center">
                                        <span class="admin-state-icon"
                                              title="@(user.IsBlocked ? "Blocked" : "Active")">
                                            <i class="bi @(user.IsBlocked ? "bi-lock-fill" : "bi-unlock")"></i>
                                        </span>
                                    </td>

                                    <td class="col-status ta-center">
                                        <span class="admin-state-icon"
                                              title="@(user.IsAdmin ? "Admin" : "User")">
                                            <i class="bi @(user.IsAdmin ? "bi-shield-fill-check" : "bi-person")"></i>
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            const selectAll = document.getElementById("selectAll");
            const blockBtn = document.getElementById("blockUsersBtn");
            const unblockBtn = document.getElementById("unblockUsersBtn");
            const deleteBtn = document.getElementById("deleteUsersBtn");
            const addAdminBtn = document.getElementById("addAdminBtn");
            const removeAdminBtn = document.getElementById("removeAdminBtn");

            function userChecks() {
                return Array.from(document.querySelectorAll(".user-checkbox"));
            }

            function selectedChecks() {
                return userChecks().filter(x => x.checked);
            }

            function syncCheckAll() {
                if (!selectAll) return;

                const all = userChecks();
                const checked = all.filter(x => x.checked).length;

                selectAll.checked = all.length > 0 && checked === all.length;
                selectAll.indeterminate = checked > 0 && checked < all.length;
            }

            function syncButtons() {
                const hasSelected = selectedChecks().length > 0;

                if (blockBtn) blockBtn.disabled = !hasSelected;
                if (unblockBtn) unblockBtn.disabled = !hasSelected;
                if (deleteBtn) deleteBtn.disabled = !hasSelected;
                if (addAdminBtn) addAdminBtn.disabled = !hasSelected;
                if (removeAdminBtn) removeAdminBtn.disabled = !hasSelected;
            }

            document.addEventListener("change", function (e) {
                const cb = e.target.closest(".user-checkbox");
                if (!cb) return;

                syncCheckAll();
                syncButtons();
            });

            if (selectAll) {
                selectAll.addEventListener("change", function () {
                    userChecks().forEach(cb => cb.checked = selectAll.checked);
                    syncCheckAll();
                    syncButtons();
                });
            }

            syncCheckAll();
            syncButtons();
        })();
    </script>
}
@using DLInventoryApp.ViewModels.Inventories.Pages
@model EditInventoryVm

<form asp-action="Edit"
      asp-route-inventoryId="@Model.InventoryId"
      method="post"
      id="inventoryEditForm"
      class="item-page-form">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="InventoryId" />
    <input type="hidden" asp-for="Version" />

    <div class="inv-page-card item-page-scroll">

        <div class="inv-page-head">
            <div>
                <div class="inv-page-title">Edit inventory</div>
                <div class="inv-page-subtitle">Update inventory settings and metadata</div>
            </div>

            <div class="inv-page-actions">
                <a asp-controller="Inventories"
                   asp-action="Details"
                   asp-route-id="@Model.InventoryId"
                   asp-route-tab="settings"
                   class="app-btn app-btn-ghost"
                   title="Back"
                   aria-label="Back">
                    <i class="bi bi-arrow-left"></i>
                </a>

                <button class="app-btn app-btn-primary"
                        type="submit"
                        title="Save"
                        aria-label="Save">
                    <i class="bi bi-check-lg"></i>
                </button>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="inv-settings-grid">

            <div class="inv-settings-row">
                <div class="inv-settings-label">Title</div>
                <div class="inv-settings-field">
                    <input asp-for="Title"
                           class="inv-settings-input"
                           placeholder="Inventory title" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
            </div>

            <div class="inv-settings-row">
                <div class="inv-settings-label">Description</div>
                <div class="inv-settings-field">
                    <textarea asp-for="Description"
                              class="inv-settings-textarea"
                              rows="6"
                              placeholder="Markdown supported..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <div class="inv-settings-row">
                <div class="inv-settings-label">Category</div>
                <div class="inv-settings-field">
                    <select asp-for="CategoryId" class="inv-settings-input">
                        <option value="">Select category...</option>

                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
            </div>

            <div class="inv-settings-row">
                <div class="inv-settings-label">Public</div>
                <div class="inv-settings-field">
                    <label class="inv-check-line">
                        <input asp-for="IsPublic" type="checkbox" />
                        <span class="inv-muted">
                            If public, all authenticated users can add items.
                        </span>
                    </label>
                    <span asp-validation-for="IsPublic" class="text-danger"></span>
                </div>
            </div>

            <div class="inv-settings-row">
                <div class="inv-settings-label">Tags</div>
                <div class="inv-settings-field inv-settings-tags-field">

                    <div class="tag-input-wrap position-relative">
                        <div class="d-flex gap-2 align-items-center">
                            <input type="text"
                                   id="tagInputEdit"
                                   class="inv-settings-input"
                                   placeholder="Type tag and press Add" />

                            <button type="button"
                                    id="addTagBtnEdit"
                                    class="app-btn app-btn-primary"
                                    title="Add tag"
                                    aria-label="Add tag">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>

                        <div id="tagSuggestListEdit"
                             class="tag-suggest shadow-sm"
                             style="display:none;"></div>
                    </div>

                    <div id="tagsChipsEdit" class="tags-chips mt-2"></div>

                    @if (Model.Tags != null)
                    {
                        for (int i = 0; i < Model.Tags.Count; i++)
                        {
                            <input type="hidden" name="Tags[@i]" value="@Model.Tags[i]" />
                        }
                    }
                </div>
            </div>

        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const form = document.getElementById("inventoryEditForm");
            if (!form) return;

            const tagInput = document.getElementById("tagInputEdit");
            const addTagBtn = document.getElementById("addTagBtnEdit");
            const chipsEl = document.getElementById("tagsChipsEdit");
            const suggestBox = document.getElementById("tagSuggestListEdit");

            const tags = new Set((@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Tags ?? new List<string>()))) || []);

            function normalize(v) {
                return (v || "").trim().toLowerCase();
            }

            function closeSuggest() {
                if (!suggestBox) return;
                suggestBox.style.display = "none";
                suggestBox.innerHTML = "";
            }

            function rebuildHiddenInputs() {
                form.querySelectorAll('input[data-tag-hidden="1"]').forEach(x => x.remove());

                Array.from(tags)
                    .map(normalize)
                    .filter(Boolean)
                    .sort()
                    .forEach((tag, index) => {
                        const input = document.createElement("input");
                        input.type = "hidden";
                        input.name = `Tags[${index}]`;
                        input.value = tag;
                        input.setAttribute("data-tag-hidden", "1");
                        form.appendChild(input);
                    });
            }

            function renderTags() {
                if (!chipsEl) return;
                chipsEl.innerHTML = "";

                Array.from(tags)
                    .map(normalize)
                    .filter(Boolean)
                    .sort()
                    .forEach(t => {
                        const chip = document.createElement("span");
                        chip.className = "tag-chip";
                        chip.textContent = t;

                        const btn = document.createElement("button");
                        btn.type = "button";
                        btn.className = "tag-chip-x";
                        btn.textContent = "×";

                        btn.onclick = () => {
                            tags.delete(t);
                            renderTags();
                            rebuildHiddenInputs();
                        };

                        chip.appendChild(btn);
                        chipsEl.appendChild(chip);
                    });
            }

            function addTag() {
                if (!tagInput) return;
                const t = normalize(tagInput.value);
                if (!t) return;

                tags.add(t);
                tagInput.value = "";
                renderTags();
                rebuildHiddenInputs();
                closeSuggest();
            }

            function showSuggest(items) {
                if (!suggestBox) return;

                suggestBox.innerHTML = "";
                if (!items || items.length === 0) {
                    closeSuggest();
                    return;
                }

                items.forEach(name => {
                    const row = document.createElement("div");
                    row.className = "tag-suggest-item";
                    row.textContent = name;

                    row.addEventListener("mousedown", (e) => {
                        e.preventDefault();
                        const n = normalize(name);
                        if (n) tags.add(n);
                        if (tagInput) tagInput.value = "";
                        renderTags();
                        rebuildHiddenInputs();
                        closeSuggest();
                    });

                    suggestBox.appendChild(row);
                });

                suggestBox.style.display = "block";
            }

            let lastQuery = "";

            async function loadSuggest() {
                if (!tagInput) return;

                const current = normalize(tagInput.value || "");
                if (!current || current.length < 2) {
                    closeSuggest();
                    return;
                }

                if (current === lastQuery) return;
                lastQuery = current;

                try {
                    const resp = await fetch(`/Tags/Suggest?prefix=${encodeURIComponent(current)}`, {
                        credentials: "same-origin"
                    });

                    if (!resp.ok) {
                        closeSuggest();
                        return;
                    }

                    const names = await resp.json();

                    const filtered = (names || [])
                        .map(n => normalize(n))
                        .filter(n => n && !tags.has(n))
                        .slice(0, 10);

                    showSuggest(filtered);
                } catch {
                    closeSuggest();
                }
            }

            if (addTagBtn) {
                addTagBtn.addEventListener("click", addTag);
            }

            if (tagInput) {
                tagInput.addEventListener("keydown", (e) => {
                    if (e.key === "Enter") {
                        e.preventDefault();
                        addTag();
                    }
                });

                let tmr = null;
                tagInput.addEventListener("input", () => {
                    clearTimeout(tmr);
                    tmr = setTimeout(loadSuggest, 150);
                });
            }

            document.addEventListener("click", (e) => {
                if (tagInput && e.target !== tagInput && suggestBox && !suggestBox.contains(e.target)) {
                    closeSuggest();
                }
            });

            renderTags();
            rebuildHiddenInputs();
        })();
    </script>
}
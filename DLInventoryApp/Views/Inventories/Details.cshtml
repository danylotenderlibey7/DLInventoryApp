@model DLInventoryApp.ViewModels.Inventories.Pages.InventoryDetailsShellVm

<div class="page-header">
        <h1 class="page-title">@Model.Title</h1>
        <p class="page-subtitle">All changes saved</p>
</div>

<div class="details-tabs-mobile-wrap">
    <div class="details-tabs-scroll" id="detailsTabsScroll">
        <partial name="Tabs/_TabsBar" model="Model" />
    </div>
</div>

<div class="tab-body">
    @switch (Model.ActiveTab)
    {
        case "items":
            <partial name="Tabs/_Items" model="Model" />
            break;

        case "chat":
            <partial name="Tabs/_Chat" model="Model.Discussion" />
            break;

        case "settings":
            <partial name="Tabs/_Settings" model="Model.Settings" />
            break;

        case "customid":
            <partial name="Tabs/_CustomId" model="Model.CustomId" />
            break;

        case "fields":
            <partial name="Tabs/_Fields" model="Model.Fields" />
            break;

        case "access":
            <partial name="Tabs/_Access" model="Model.Accesses" />
            break;

        default:
            <partial name="Tabs/_Items" model="Model" />
            break;
    }
</div>
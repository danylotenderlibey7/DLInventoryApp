@using DLInventoryApp.Models
@model DLInventoryApp.ViewModels.CustomFields.InventoryFieldsVm

@{
    var vm = Model;
    var canManage = vm.CanManage;
}

<form id="fieldsAntiForgery" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<div class="chat-feed">
    <div class="duo-layout fields-layout"
         id="fieldsRoot"
         data-can-write="@(canManage ? "1" : "0")"
         data-inventory-id="@vm.InventoryId">

        <div class="duo-grid fields-grid">
            <div class="duo-left fields-left">
                <div class="card-elements fields-card">
                    <div class="card-elements-head">
                        <div class="card-elements-title">Fields</div>

                        @if (canManage)
                        {
                            <button id="fieldsAddBtn"
                                    type="button"
                                    class="app-btn app-btn-primary app-btn-icon"
                                    title="Add field"
                                    aria-label="Add field">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        }
                    </div>

                    @if (!canManage)
                    {
                        <div class="note-block fields-readonly-note">You have read-only access.</div>
                    }

                    <div id="fieldsState" class="save-text fields-state"></div>

                    <div id="fieldsScroll" class="elements-scroll fields-scroll">
                        @if (vm.Fields == null || vm.Fields.Count == 0)
                        {
                            <div class="empty-block fields-empty">
                                No fields yet.
                            </div>

                            <ul id="fieldsList" class="elements-list" style="display:none;"></ul>
                        }
                        else
                        {
                            <ul id="fieldsList" class="elements-list">
                                @foreach (var f in vm.Fields.OrderBy(x => x.Order))
                                {
                                    <li class="elements-item field-row"
                                        data-id="@f.Id"
                                        data-row-id="@f.Id"
                                        data-version="@f.Version">

                                        <div class="drag-handle" title="Drag">↕</div>

                                        <div class="item-main field-main">
                                            <div class="item-line field-line">
                                                <input class="input-field"
                                                       data-field="name"
                                                       value="@f.Name"
                                                       placeholder="Field name"
                                                @(canManage ? "" : "disabled") />

                                                <select class="select-field"
                                                        data-field="type"
                                                @(canManage ? "" : "disabled")>
                                                    @foreach (CustomFieldType t in Enum.GetValues(typeof(CustomFieldType)))
                                                    {
                                                        <option value="@((int)t)" selected="@(t == f.Type)">@t</option>
                                                    }
                                                </select>
                                            </div>
                                            <textarea class="input-field field-description"
                                                      data-field="description"
                                                      placeholder="Description (optional)"
                                            @(canManage ? "" : "disabled")>@f.Description</textarea>

                                            <div class="field-flags">
                                                <label class="fields3-flag">
                                                    <input type="checkbox"
                                                           data-field="showInTable"
                                                    @(f.ShowInTable ? "checked" : "")
                                                    @(canManage ? "" : "disabled") />
                                                    Show in table
                                                </label>

                                                <div class="save-text field-save-state" data-save-state="@f.Id"></div>
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>

            <div class="duo-right fields-right">
                <div id="fieldsTrash" class="trash-zone">
                    <div class="trash-head">
                        <div class="trash-title">Delete</div>
                        <div class="trash-sub">Drop here to delete</div>
                    </div>

                    <div id="fieldsTrashDrop" class="trash-drop"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<script>
    (function () {
        const root = document.getElementById("fieldsRoot");
        if (!root) return;

        const canWrite = root.dataset.canWrite === "1";
        const inventoryId = root.dataset.inventoryId;

        let listEl = document.getElementById("fieldsList");
        const addBtn = document.getElementById("fieldsAddBtn");
        const trashEl = document.getElementById("fieldsTrashDrop");
        const stateEl = document.getElementById("fieldsState");
        const countEl = document.getElementById("fieldsCount");

        let sortableList = null;
        let sortableTrash = null;

        const dirtyRows = new Set();
        const savingRows = new Set();
        const autosaveIntervalMs = 8000;
        let autosaveHandle = null;

        function updateCount() {
            if (!countEl) return;
            const n = document.querySelectorAll('#fieldsList li[data-id]').length;
            countEl.textContent = n.toString();
            refreshOrders();
        }

        function refreshOrders() {
            const rows = document.querySelectorAll('#fieldsList li[data-row-id]');
            rows.forEach((row, index) => {
                const orderEl = row.querySelector('.field-order-inline');
                if (orderEl) {
                    orderEl.textContent = `[${index + 1}]`;
                }
            });
        }

        function getToken() {
            const f = document.getElementById("fieldsAntiForgery");
            if (!f) return "";
            const t = f.querySelector('input[name="__RequestVerificationToken"]');
            return t ? t.value : "";
        }

        function setState(text, isErr) {
            if (!stateEl) return;
            stateEl.textContent = text || "";
            stateEl.classList.toggle("is-error", !!isErr);
        }

        function setRowState(rowId, text, isErr) {
            const el = document.querySelector('[data-save-state="' + rowId + '"]');
            if (!el) return;
            el.textContent = text || "";
            el.classList.toggle("is-error", !!isErr);
            el.classList.toggle("is-ok", !isErr && !!text && text.toLowerCase().indexOf("saved") >= 0);
            el.classList.toggle("is-wip", !isErr && !!text && (text.toLowerCase().indexOf("saving") >= 0 || text.toLowerCase().indexOf("unsaved") >= 0));
        }

        function markDirty(rowId) {
            if (!rowId) return;
            dirtyRows.add(String(rowId));
            if (!savingRows.has(String(rowId))) {
                setRowState(rowId, "Unsaved", false);
            }
        }

        async function postJson(url, body) {
            const resp = await fetch(url, {
                method: "POST",
                credentials: "same-origin",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": getToken()
                },
                body: JSON.stringify(body || {})
            });

            const text = await resp.text();
            let data = null;
            try { data = JSON.parse(text); } catch {}

            if (!resp.ok) {
                const msg = (data && (data.error || data.title)) ? (data.error || data.title) : `HTTP ${resp.status}`;
                throw new Error(msg);
            }

            return data;
        }

        async function saveRow(rowId) {
            const row = document.querySelector('li[data-row-id="' + rowId + '"]');
            if (!row) {
                dirtyRows.delete(String(rowId));
                savingRows.delete(String(rowId));
                return;
            }

            const nameEl = row.querySelector('[data-field="name"]');
            const typeEl = row.querySelector('[data-field="type"]');
            const descEl = row.querySelector('[data-field="description"]');
            const showEl = row.querySelector('[data-field="showInTable"]');

            const dto = {
                name: nameEl ? nameEl.value : "",
                type: typeEl ? parseInt(typeEl.value || "0", 10) : 0,
                description: descEl ? descEl.value : "",
                showInTable: showEl ? !!showEl.checked : false,
                version: Number(row.dataset.version || 0)
            };

            savingRows.add(String(rowId));
            setRowState(rowId, "Saving…", false);

            try {
                const data = await postJson(`/Inventories/${inventoryId}/Fields/${rowId}/InlineUpdate`, dto);

                if (data && data.version !== undefined) {
                    row.dataset.version = data.version;
                }

                dirtyRows.delete(String(rowId));
                setRowState(rowId, "Saved", false);
            } catch (e) {
                console.error(e);
                setRowState(rowId, "Error", true);
                setState("Error: " + e.message, true);
            } finally {
                savingRows.delete(String(rowId));
            }
        }

        async function flushDirtyRows() {
            if (dirtyRows.size === 0) return;

            const ids = Array.from(dirtyRows);
            for (const rowId of ids) {
                if (savingRows.has(String(rowId))) continue;
                await saveRow(rowId);
            }
        }

        function startAutosave() {
            if (autosaveHandle) clearInterval(autosaveHandle);
            autosaveHandle = setInterval(function () {
                flushDirtyRows();
            }, autosaveIntervalMs);
        }

        document.addEventListener("input", function (e) {
            const field = e.target.closest("[data-field]");
            if (!field) return;

            const row = e.target.closest('li[data-row-id]');
            if (!row) return;

            markDirty(row.getAttribute("data-row-id"));
        });

        document.addEventListener("change", function (e) {
            const field = e.target.closest("[data-field]");
            if (!field) return;

            const row = e.target.closest('li[data-row-id]');
            if (!row) return;

            markDirty(row.getAttribute("data-row-id"));
        });

        function escapeHtml(s) {
            return (s ?? "").toString()
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

        function buildTypeOptions(selected) {
            const opts = [
                { v: @((int)CustomFieldType.SingleLineText), t: "SingleLineText" },
                { v: @((int)CustomFieldType.MultiLineText),  t: "MultiLineText"  },
                { v: @((int)CustomFieldType.DocumentLink),   t: "DocumentLink"   },
                { v: @((int)CustomFieldType.Number),         t: "Number"         },
                { v: @((int)CustomFieldType.Boolean),        t: "Boolean"        }
            ];

            return opts.map(o =>
                `<option value="${o.v}" ${o.v === selected ? "selected" : ""}>${o.t}</option>`
            ).join("");
        }

        function ensureListVisible() {
            if (!listEl) return;
            listEl.style.display = "";
            const empty = document.querySelector("#fieldsScroll .empty-block");
            if (empty) empty.remove();
        }

        function createRowHtml(field) {
            const li = document.createElement("li");
            li.className = "elements-item field-row";
            li.setAttribute("data-id", field.id);
            li.setAttribute("data-row-id", field.id);
            li.setAttribute("data-version", field.version || "");

            li.innerHTML = `
                <div class="drag-handle" title="Drag">↕</div>

                <div class="item-main field-main">
                    <div class="item-line field-line">
                        <input class="input-field"
                               data-field="name"
                               value="${escapeHtml(field.name || "")}"
                               placeholder="Field name"
                               ${canWrite ? "" : "disabled"} />

                        <select class="select-field"
                                data-field="type"
                                ${canWrite ? "" : "disabled"}>
                            ${buildTypeOptions(parseInt(field.type, 10))}
                        </select>
                    </div>

                    <textarea class="input-field field-description"
                      data-field="description"
                      placeholder="Description (optional)"
                      ${canWrite ? "" : "disabled"}>${escapeHtml(field.description || "")}</textarea>

                    <div class="field-flags">
                      <label class="fields3-flag">
                        <input type="checkbox"
                               data-field="showInTable"
                               ${field.showInTable ? "checked" : ""}
                               ${canWrite ? "" : "disabled"} />
                        Show in table
                      </label>

                      <div class="save-text field-save-state" data-save-state="${field.id}"></div>
                    </div>
                </div>
            `;

            return li;
        }

        if (addBtn) {
            addBtn.addEventListener("click", async function () {
                if (!canWrite) return;

                setState("Adding…", false);

                try {
                    const data = await postJson(`/Inventories/${inventoryId}/Fields/Add`, {});
                    if (!data || !data.field) return;

                    ensureListVisible();
                    const row = createRowHtml(data.field);
                    listEl.appendChild(row);
                    updateCount();

                    setState("", false);

                    const scroll = document.getElementById("fieldsScroll");
                    if (scroll) scroll.scrollTop = scroll.scrollHeight;
                } catch (e) {
                    console.error(e);
                    setState("Error: " + e.message, true);
                }
            });
        }

        async function persistReorder() {
            if (!listEl) return;

            const ids = Array.from(listEl.querySelectorAll('li[data-id]'))
                .map(li => parseInt(li.getAttribute("data-id"), 10))
                .filter(n => Number.isFinite(n));

            try {
                const data = await postJson(`/Inventories/${inventoryId}/Fields/Reorder`, ids);

                if (data && Array.isArray(data.versions)) {
                    data.versions.forEach(v => {
                        const row = document.querySelector('li[data-row-id="' + v.id + '"]');
                        if (row) {
                            row.dataset.version = v.version;
                        }
                    });
                }

                refreshOrders();
            } catch (e) {
                console.error(e);
                setState("Error: " + e.message, true);
            }
        }

        async function deleteField(id) {
            await postJson(`/Inventories/${inventoryId}/Fields/${id}/Delete`, {});
        }

        function initSortables() {
            listEl = document.getElementById("fieldsList");
            if (!listEl || !trashEl) return;

            if (sortableList) sortableList.destroy();
            if (sortableTrash) sortableTrash.destroy();

            sortableList = Sortable.create(listEl, {
                animation: 150,
                handle: ".drag-handle",
                group: { name: "fieldsGroup", pull: true, put: false },
                onEnd: function () {
                    persistReorder();
                }
            });

            sortableTrash = Sortable.create(trashEl, {
                animation: 150,
                group: { name: "fieldsGroup", pull: false, put: true },
                onAdd: async function (evt) {
                    const li = evt.item;
                    if (!li) return;

                    const id = parseInt(li.getAttribute("data-id"), 10);
                    dirtyRows.delete(String(id));
                    savingRows.delete(String(id));

                    setState("Deleting…", false);

                    try {
                        await deleteField(id);
                        li.parentNode && li.parentNode.removeChild(li);
                        updateCount();
                        await persistReorder();

                        setState("Deleted", false);
                        setTimeout(() => {
                            if (stateEl && stateEl.textContent === "Deleted") setState("", false);
                        }, 900);
                    } catch (e) {
                        console.error(e);
                        setState("Error: " + e.message, true);
                        if (listEl) listEl.appendChild(li);
                    }
                }
            });
        }

        initSortables();
        refreshOrders();
        startAutosave();

        if (!canWrite) {
            if (sortableList) sortableList.option("disabled", true);
            if (sortableTrash) sortableTrash.option("disabled", true);
        }
    })();
</script>
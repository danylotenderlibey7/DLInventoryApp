@page
@model ExternalLoginsModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "External logins";
    ViewData["ActivePage"] = ManageNavPages.ExternalLogins;
}

<div class="workspace-inner profile-page">
    <div class="manage-layout">

        <aside class="manage-sidebar">
            <partial name="_ManageNav" />
        </aside>

        <div class="manage-content">

            <div class="page-header">
                <div>
                    <h1 class="page-title">External logins</h1>
                    <p class="page-subtitle">
                        Connect or remove external authentication providers.
                    </p>
                </div>
            </div>

            <partial name="_StatusMessage" for="StatusMessage" />

            @if (Model.CurrentLogins?.Count > 0)
            {
                <div class="manage-form-card">
                    <div class="manage-section-title">Connected accounts</div>

                    <div class="external-login-list">
                        @foreach (var login in Model.CurrentLogins)
                        {
                            var icon = "bi-box-arrow-in-right";

                            if (login.LoginProvider.ToLower().Contains("google"))
                                icon = "bi-google";

                            if (login.LoginProvider.ToLower().Contains("facebook"))
                                icon = "bi-facebook";

                            <div class="external-login-item">
                                <div class="external-login-info">
                                    <i class="bi @icon"></i>
                                    <span>@login.ProviderDisplayName</span>
                                </div>

                                @if (Model.ShowRemoveButton)
                                {
                                    <form asp-page-handler="RemoveLogin" method="post" class="external-login-remove-form">
                                        <input name="LoginProvider" type="hidden" value="@login.LoginProvider" />
                                        <input name="ProviderKey" type="hidden" value="@login.ProviderKey" />

                                        <button type="submit"
                                                class="external-login-remove-btn"
                                                title="Remove @login.ProviderDisplayName"
                                                aria-label="Remove @login.ProviderDisplayName">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @if (Model.OtherLogins?.Count > 0)
            {
                <div class="manage-form-card">
                    <div class="manage-section-title">Add login provider</div>

                    <form asp-page-handler="LinkLogin" method="post">
                        <div class="external-login-add">
                            @foreach (var provider in Model.OtherLogins)
                            {
                                var icon = "bi-box-arrow-in-right";

                                if (provider.Name.ToLower().Contains("google"))
                                    icon = "bi-google";

                                if (provider.Name.ToLower().Contains("facebook"))
                                    icon = "bi-facebook";

                                <button type="submit"
                                        class="auth-provider-btn"
                                        name="provider"
                                        value="@provider.Name"
                                        title="Connect @provider.DisplayName">
                                    <i class="bi @icon"></i>
                                    <span>@provider.DisplayName</span>
                                </button>
                            }
                        </div>
                    </form>
                </div>
            }

        </div>

    </div>
</div>
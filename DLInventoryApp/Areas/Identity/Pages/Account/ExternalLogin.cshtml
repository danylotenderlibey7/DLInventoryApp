@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Register";
}
@inject Microsoft.Extensions.Localization.IStringLocalizer<DLInventoryApp.Localization.SharedResource> LocalizerS
@inject Microsoft.Extensions.Localization.IStringLocalizer<DLInventoryApp.Localization.UserResource> LocalizerU
@inject Microsoft.Extensions.Localization.IStringLocalizer<DLInventoryApp.Localization.AuthResource> LocalizerA

<h1>@ViewData["Title"]</h1>
<h2 id="external-login-title">@LocalizerA["AssociateYour"] @Model.ProviderDisplayName account.</h2>
<hr />

<p id="external-login-description" class="text-info">
    @LocalizerA["YouSuccessfullyAuthenticatedWith"] <strong>@Model.ProviderDisplayName</strong>.
    @LocalizerA["PleaseEnterEmailETC"]
</p>

<div class="row">
    <div class="col-md-4">
        <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="@LocalizerA["PleaseEnterEmail"]" />
                <label asp-for="Input.Email" class="form-label">@LocalizerA["PleaseEnterEmail"]</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Register</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

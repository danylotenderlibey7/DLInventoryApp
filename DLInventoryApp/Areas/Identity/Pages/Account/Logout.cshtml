@page
@model LogoutModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Log out";
}
@inject Microsoft.Extensions.Localization.IStringLocalizer<DLInventoryApp.Localization.SharedResource> LocalizerS
@inject Microsoft.Extensions.Localization.IStringLocalizer<DLInventoryApp.Localization.UserResource> LocalizerU
@inject Microsoft.Extensions.Localization.IStringLocalizer<DLInventoryApp.Localization.AuthResource> LocalizerA

<div class="workspace-inner auth-wide-page">
    <section class="auth-wide-card">
        <div class="auth-wide-grid">

            <div class="auth-side">
                <h1 class="auth-side-title">@LocalizerA["LogOut"]</h1>

                <p class="auth-side-text">
                    @LocalizerA["EndCurrentSessionETC"]
                </p>

                <div class="auth-side-actions">
                    <a class="auth-action-card" asp-page="/Account/Login" asp-area="Identity">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <div>
                            <div class="auth-action-title">@LocalizerA["BackToLogin"]</div>
                            <div class="auth-action-text">@LocalizerA["SignInWithAnotherAccount"]</div>
                        </div>
                    </a>

                    <a class="auth-action-card" asp-page="/Account/Register" asp-area="Identity">
                        <i class="bi bi-person-plus"></i>
                        <div>
                            <div class="auth-action-title">@LocalizerA["CreateAccount"]</div>
                            <div class="auth-action-text">@LocalizerA["RegisterNewAccount"]</div>
                        </div>
                    </a>

                    <a class="auth-action-card" asp-controller="Inventories" asp-action="Index">
                        <i class="bi bi-house-door"></i>
                        <div>
                            <div class="auth-action-title">@LocalizerA["GoHome"]</div>
                            <div class="auth-action-text">@LocalizerA["ReturnToTheMainPage"].</div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="auth-form-side">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <div class="auth-form-head">
                        <h2 class="auth-form-title">@LocalizerA["ConfirmLogout"]</h2>
                        <p class="auth-form-subtitle">@LocalizerA["YouAboutEndSession"]</p>
                    </div>

                    <form class="auth-form-block"
                          asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Page("/", new { area = "" })"
                          method="post">
                        <button type="submit" class="app-btn app-btn-primary auth-submit">
                            @LocalizerA["LogOut"]
                        </button>
                    </form>
                }
                else
                {
                    <div class="auth-form-head">
                        <h2 class="auth-form-title">@LocalizerA["LoggedOut"]</h2>
                        <p class="auth-form-subtitle">@LocalizerA["YouHaveSuccessfullyLoggedOut"]</p>
                    </div>

                    <div class="auth-form-block">
                        <a class="app-btn app-btn-primary auth-submit"
                           asp-controller="Inventories"
                           asp-action="Index">
                            @LocalizerA["GoHome"]
                        </a>
                    </div>
                }
            </div>

        </div>
    </section>
</div>
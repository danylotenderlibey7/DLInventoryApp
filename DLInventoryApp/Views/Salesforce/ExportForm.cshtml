@model DLInventoryApp.ViewModels.Salesforce.SalesforceExportVm
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Export to Salesforce";
}

<div class="workspace-inner profile-page">
    <div class="manage-layout">

        <aside class="manage-sidebar">
            <partial name="_SalesforceNav" />
        </aside>

        <div class="manage-content">

            <div class="page-header">
                <div>
                    <h1 class="page-title">Export to Salesforce</h1>
                    <p class="page-subtitle">Create a Salesforce Account with a linked Contact</p>
                </div>
            </div>

            @if (TempData["StatusMessage"] != null)
            {
                <div class="sf-status-message">
                    @TempData["StatusMessage"]
                </div>
            }

            <div asp-validation-summary="ModelOnly" class="auth-validation"></div>

            <div class="manage-form-card">
                <form asp-controller="Salesforce"
                      asp-action="ExportForm"
                      method="post"
                      class="manage-form">
                    @Html.AntiForgeryToken()

                    <div class="manage-form-grid">
                        <div class="auth-field">
                            <label asp-for="FirstName" class="auth-label"></label>
                            <input asp-for="FirstName" class="auth-input" />
                            <span asp-validation-for="FirstName" class="auth-field-error"></span>
                        </div>

                        <div class="auth-field">
                            <label asp-for="LastName" class="auth-label"></label>
                            <input asp-for="LastName" class="auth-input" />
                            <span asp-validation-for="LastName" class="auth-field-error"></span>
                        </div>

                        <div class="auth-field">
                            <label asp-for="Email" class="auth-label"></label>
                            <input asp-for="Email" class="auth-input" />
                            <span asp-validation-for="Email" class="auth-field-error"></span>
                        </div>

                        <div class="auth-field">
                            <label asp-for="Phone" class="auth-label"></label>
                            <input asp-for="Phone" class="auth-input" />
                            <span asp-validation-for="Phone" class="auth-field-error"></span>
                        </div>

                        <div class="auth-field">
                            <label asp-for="CompanyName" class="auth-label"></label>
                            <input asp-for="CompanyName" class="auth-input" />
                            <span asp-validation-for="CompanyName" class="auth-field-error"></span>
                        </div>

                        <div class="auth-field">
                            <label asp-for="JobTitle" class="auth-label"></label>
                            <input asp-for="JobTitle" class="auth-input" />
                            <span asp-validation-for="JobTitle" class="auth-field-error"></span>
                        </div>

                        <div class="manage-actions-row">
                            <button type="submit" class="app-btn app-btn-primary auth-submit">
                                <i class="bi bi-cloud-upload"></i>
                                <span>Export to Salesforce</span>
                            </button>
                        </div>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page
@model LogoutModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Log out";
}

<div class="workspace-inner auth-wide-page">
    <section class="auth-wide-card">
        <div class="auth-wide-grid">

            <div class="auth-side">
                <h1 class="auth-side-title">Log out</h1>

                <p class="auth-side-text">
                    End the current session or return back to the application.
                </p>

                <div class="auth-side-actions">
                    <a class="auth-action-card" asp-page="/Account/Login" asp-area="Identity">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <div>
                            <div class="auth-action-title">Back to login</div>
                            <div class="auth-action-text">Sign in with another account.</div>
                        </div>
                    </a>

                    <a class="auth-action-card" asp-page="/Account/Register" asp-area="Identity">
                        <i class="bi bi-person-plus"></i>
                        <div>
                            <div class="auth-action-title">Create account</div>
                            <div class="auth-action-text">Register a new user account.</div>
                        </div>
                    </a>

                    <a class="auth-action-card" asp-controller="Inventories" asp-action="Index">
                        <i class="bi bi-house-door"></i>
                        <div>
                            <div class="auth-action-title">Go home</div>
                            <div class="auth-action-text">Return to the main page.</div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="auth-form-side">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <div class="auth-form-head">
                        <h2 class="auth-form-title">Confirm logout</h2>
                        <p class="auth-form-subtitle">You are about to end your current session</p>
                    </div>

                    <form class="auth-form-block"
                          asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Page("/", new { area = "" })"
                          method="post">
                        <button type="submit" class="app-btn app-btn-primary auth-submit">
                            Log out
                        </button>
                    </form>
                }
                else
                {
                    <div class="auth-form-head">
                        <h2 class="auth-form-title">Logged out</h2>
                        <p class="auth-form-subtitle">You have successfully logged out of the application</p>
                    </div>

                    <div class="auth-form-block">
                        <a class="app-btn app-btn-primary auth-submit"
                           asp-controller="Inventories"
                           asp-action="Index">
                            Go to home page
                        </a>
                    </div>
                }
            </div>

        </div>
    </section>
</div>
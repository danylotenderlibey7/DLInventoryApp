@page
@model ResetPasswordModel

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Reset password";
}

<div class="workspace-inner auth-wide-page">
    <section class="auth-wide-card">
        <div class="auth-wide-grid">

            <div class="auth-side">
                <h1 class="auth-side-title">Reset password</h1>

                <p class="auth-side-text">
                    Enter your email and set a new password for your account.
                </p>

                <div class="auth-side-actions">
                    <a class="auth-action-card" asp-page="./Login">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <div>
                            <div class="auth-action-title">Back to login</div>
                            <div class="auth-action-text">Return to the login page.</div>
                        </div>
                    </a>

                    <a class="auth-action-card" asp-page="./Register">
                        <i class="bi bi-person-plus"></i>
                        <div>
                            <div class="auth-action-title">Create account</div>
                            <div class="auth-action-text">Register a new user account.</div>
                        </div>
                    </a>

                    <a class="auth-action-card" asp-page="./ForgotPassword">
                        <i class="bi bi-key"></i>
                        <div>
                            <div class="auth-action-title">Request new reset link</div>
                            <div class="auth-action-text">Send another password reset email.</div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="auth-form-side">
                <div class="auth-form-head">
                    <h2 class="auth-form-title">Set new password</h2>
                    <p class="auth-form-subtitle">Fill in the fields below</p>
                </div>

                <form method="post" class="auth-form-block">
                    <div asp-validation-summary="ModelOnly" class="auth-validation"></div>

                    <input asp-for="Input.Code" type="hidden" />

                    <div class="auth-field">
                        <label asp-for="Input.Email" class="auth-label"></label>
                        <input asp-for="Input.Email"
                               class="auth-input"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="auth-field-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Input.Password" class="auth-label"></label>
                        <input asp-for="Input.Password"
                               class="auth-input"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="New password" />
                        <span asp-validation-for="Input.Password" class="auth-field-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Input.ConfirmPassword" class="auth-label"></label>
                        <input asp-for="Input.ConfirmPassword"
                               class="auth-input"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Repeat password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="auth-field-error"></span>
                    </div>

                    <button type="submit" class="app-btn app-btn-primary auth-submit">
                        Reset password
                    </button>
                </form>
            </div>

        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
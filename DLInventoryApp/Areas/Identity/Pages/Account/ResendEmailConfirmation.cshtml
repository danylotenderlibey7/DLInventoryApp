@page
@model ResendEmailConfirmationModel

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Resend email confirmation";
}

<div class="workspace-inner auth-wide-page">
    <section class="auth-wide-card">
        <div class="auth-wide-grid">

            <div class="auth-side">
                <h1 class="auth-side-title">Resend confirmation</h1>

                <p class="auth-side-text">
                    Enter your email address and we will send a new confirmation link.
                </p>

                <div class="auth-side-actions">
                    <a class="auth-action-card" asp-page="./Login">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <div>
                            <div class="auth-action-title">Back to login</div>
                            <div class="auth-action-text">Return to the login page.</div>
                        </div>
                    </a>

                    <a class="auth-action-card" asp-page="./Register">
                        <i class="bi bi-person-plus"></i>
                        <div>
                            <div class="auth-action-title">Create account</div>
                            <div class="auth-action-text">Register a new user account.</div>
                        </div>
                    </a>

                    <a class="auth-action-card" asp-page="./ForgotPassword">
                        <i class="bi bi-key"></i>
                        <div>
                            <div class="auth-action-title">Forgot password</div>
                            <div class="auth-action-text">Request a password reset link.</div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="auth-form-side">
                <div class="auth-form-head">
                    <h2 class="auth-form-title">Send again</h2>
                    <p class="auth-form-subtitle">We will send a new email confirmation link</p>
                </div>

                <form method="post" class="auth-form-block">
                    <div asp-validation-summary="All" class="auth-validation"></div>

                    <div class="auth-field">
                        <label asp-for="Input.Email" class="auth-label"></label>
                        <input asp-for="Input.Email"
                               class="auth-input"
                               aria-required="true"
                               placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="auth-field-error"></span>
                    </div>

                    <button type="submit" class="app-btn app-btn-primary auth-submit">
                        Resend confirmation
                    </button>
                </form>
            </div>

        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
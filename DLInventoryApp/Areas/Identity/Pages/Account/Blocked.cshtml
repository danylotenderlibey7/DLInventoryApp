@page
@model BlockedModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Account blocked";
}
@inject Microsoft.Extensions.Localization.IStringLocalizer<DLInventoryApp.Localization.SharedResource> LocalizerS
@inject Microsoft.Extensions.Localization.IStringLocalizer<DLInventoryApp.Localization.UserResource> LocalizerU
@inject Microsoft.Extensions.Localization.IStringLocalizer<DLInventoryApp.Localization.AuthResource> LocalizerA

<div class="workspace-inner auth-wide-page">
    <section class="auth-wide-card">
        <div class="auth-wide-grid">

            <div class="auth-side">

                <h1 class="auth-side-title">@LocalizerA["AccountBlocked"]</h1>

                <p class="auth-side-text">
                    @LocalizerA["YourBeenBlockedETC"]
                </p>

                <div class="auth-side-actions">

                    <a class="auth-action-card" href="mailto:support@yourapp.com">
                        <i class="bi bi-envelope"></i>
                        <div>
                            <div class="auth-action-title">@LocalizerA["ContactSupport"]</div>
                            <div class="auth-action-text">
                                @LocalizerA["SendEmaiWillReview"]
                            </div>
                        </div>
                    </a>

                    <a class="auth-action-card" asp-area="Identity" asp-page="/Account/Login">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <div>
                            <div class="auth-action-title">@LocalizerA["BackToLogin"]</div>
                            <div class="auth-action-text">
                                @LocalizerA["SignInWithAnotherAccount"]
                            </div>
                        </div>
                    </a>

                    <a class="auth-action-card" asp-page="/Index">
                        <i class="bi bi-house"></i>
                        <div>
                            <div class="auth-action-title">@LocalizerA["GoHome"]</div>
                            <div class="auth-action-text">
                                @LocalizerA["ReturnToTheMainPage"]
                            </div>
                        </div>
                    </a>

                </div>

            </div>

            <div class="auth-form-side">

                <div class="auth-form-head">
                    <h2 class="auth-form-title">@LocalizerA["AccessRestricted"]</h2>
                    <p class="auth-form-subtitle">
                        @LocalizerA["YourCurrentlyAllowedAccess"]
                    </p>
                </div>

                <div class="auth-validation">
                    @LocalizerA["YourBeenBlockedETC"]
                </div>

            </div>

        </div>
    </section>
</div>
@using DLInventoryApp.ViewModels.Items.Pages
@using DLInventoryApp.Models
@model CreateItemVm

<form asp-action="Create"
      asp-route-inventoryId="@Model.InventoryId"
      method="post"
      id="itemCreateForm"
      class="item-page-form">

    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="InventoryId" />

    <div class="inv-page-card item-page-scroll">

        <div class="inv-page-head">
            <div>
                <div class="inv-page-title">Create item</div>
                <div class="inv-page-subtitle">@Model.InventoryTitle</div>
            </div>

            <div class="inv-page-actions">
                <a asp-controller="Inventories"
                   asp-action="Details"
                   asp-route-id="@Model.InventoryId"
                   asp-route-tab="items"
                   class="app-btn app-btn-ghost"
                   title="Back"
                   aria-label="Back">
                    <i class="bi bi-arrow-left"></i>
                </a>

                <button class="app-btn app-btn-primary"
                        type="submit"
                        title="Create"
                        aria-label="Create">
                    <i class="bi bi-check-lg"></i>
                </button>
            </div>
        </div>

        <div class="item-basic-grid">
            <div class="item-basic-field item-basic-field-full">
                <label asp-for="CustomId" class="inv-settings-label">Custom ID</label>

                <input asp-for="CustomId"
                       class="inv-settings-input"
                       placeholder="@Model.PreviewCustomId" />

                <div class="item-field-hint">
                    Leave empty to generate automatically.
                </div>

                <span asp-validation-for="CustomId" class="text-danger"></span>
            </div>
        </div>

        @if (Model.Fields != null && Model.Fields.Count > 0)
        {
            <div class="item-section-divider"></div>

            <div class="item-section-head">
                <div class="item-section-title">Item fields</div>
                <div class="item-section-note">
                    Fill the fields configured for this inventory.
                </div>
            </div>

            <div class="item-custom-grid">
                @for (int i = 0; i < Model.Fields.Count; i++)
                {
                    <div class="item-basic-field">
                        <label class="inv-settings-label">
                            @Model.Fields[i].Name
                        </label>
                        @if (!string.IsNullOrWhiteSpace(Model.Fields[i].Description))
                        {
                            <div class="item-field-hint">
                                @Model.Fields[i].Description
                            </div>
                        }
                        @if (Model.Fields[i].Type == CustomFieldType.SingleLineText)
                        {
                            <input asp-for="Fields[@i].TextValue"
                                   class="inv-settings-input" />
                        }
                        else if (Model.Fields[i].Type == CustomFieldType.MultiLineText)
                        {
                            <textarea asp-for="Fields[@i].TextValue"
                                      class="inv-settings-textarea"
                                      rows="5"></textarea>
                        }
                        else if (Model.Fields[i].Type == CustomFieldType.DocumentLink)
                        {
                            <input asp-for="Fields[@i].LinkValue"
                                   class="inv-settings-input"
                                   placeholder="https://..." />
                        }
                        else if (Model.Fields[i].Type == CustomFieldType.Number)
                        {
                            <input asp-for="Fields[@i].NumberValue"
                                   type="number"
                                   class="inv-settings-input" />
                        }
                        else if (Model.Fields[i].Type == CustomFieldType.Boolean)
                        {
                            <label class="item-bool-line">
                                <input asp-for="Fields[@i].BoolValue" type="checkbox" />
                                <span class="inv-muted">Enabled</span>
                            </label>
                        }

                        <input type="hidden" asp-for="Fields[@i].CustomFieldId" />
                        <input type="hidden" asp-for="Fields[@i].Type" />
                        <input type="hidden" asp-for="Fields[@i].Name" />
                    </div>
                }
            </div>
        }
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}